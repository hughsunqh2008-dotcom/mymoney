# ============================================
# mymoney 项目 .gitignore
# 作用：告诉 git 不要跟踪这些文件
# ============================================

# ---- 虚拟环境（最重要的一条）----
# 里面是几千个第三方库文件、几十 MB，别人照 requirements.txt 自己装就行
.venv/
venv/

# ---- Python 运行缓存 ----
# 运行 .py 时自动生成，每台机器生成的不一样，没有分享价值
__pycache__/
*.pyc
*.pyo

# ---- 测试缓存 ----
.pytest_cache/

# ---- 输出产物（能重新生成，不算源码）----
out/
*.png

# ---- 编辑器本地配置 ----
# settings.json 里存的是本机解释器路径，别人电脑上没这个路径
.vscode/settings.json

# ---- 操作系统生成的垃圾文件 ----
Thumbs.db
Desktop.ini

# ---- 临时/笔记文件 ----
*.tmp
*.bak
notes.local.md
